{
  "type": "object",
  "description": "Triggered when the user creates a room.",
  "properties": {
    "eventName": {
      "enum": ["CreatedRoom"]
    },
    "isDM": {
      "description": "Whether the room is a DM.",
      "type": "boolean"
    },
    "joinRule": {
      "type": "string",
      "enum": [
        "Public",
        "Invite",
        "Restricted",
        "Knock",
        "KnockRestricted"
      ]
    }
  },
  "required": ["isDM", "eventName", "joinRule"],
  "additionalProperties": false
}
